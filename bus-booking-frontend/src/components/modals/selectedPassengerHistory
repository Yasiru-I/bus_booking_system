import React from 'react';
import {
  X,
  Mail,
  Phone,
  MapPin,
  Ban,
  Download,
  Settings,
  History,
  MessageSquare,
  RefreshCcw
} from 'lucide-react';

const PassengerHistoryModal = ({
  selectedPassengerHistory,
  setSelectedPassengerHistory,
  historyTab,
  setHistoryTab,
  handleModalStatusToggle,
  exportFullPassengerReport
}) => {
  if (!selectedPassengerHistory) return null;

  return (
    <div className="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-[1000] backdrop-blur-sm">
      <div className="bg-white rounded-3xl w-[1000px] h-[750px] shadow-2xl relative animate-fadeIn flex overflow-hidden">
        
        <button
          onClick={() => setSelectedPassengerHistory(null)}
          className="absolute top-4 right-4 text-gray-400 hover:text-gray-600 z-10"
        >
          <X className="w-6 h-6" />
        </button>

        {/* LEFT SIDE */}
        <div className="w-[30%] bg-gray-50 border-r border-gray-100 p-8 flex flex-col items-center text-center">
          <div className="relative mb-4">
            <div className="w-32 h-32 rounded-full bg-blue-100 flex items-center justify-center text-4xl font-bold text-blue-600 border-4 border-white shadow-md overflow-hidden">
              {selectedPassengerHistory.user.profile_picture ? (
                <img
                  src={selectedPassengerHistory.user.profile_picture}
                  alt="Profile"
                  className="w-full h-full object-cover"
                />
              ) : (
                selectedPassengerHistory.user.name.charAt(0)
              )}
            </div>

            <div
              className={`absolute bottom-1 right-1 w-6 h-6 border-2 border-white rounded-full ${
                selectedPassengerHistory.user.account_status === 'Active'
                  ? 'bg-green-500'
                  : 'bg-red-500'
              }`}
            />
          </div>

          <h2 className="text-xl font-black text-gray-900">
            {selectedPassengerHistory.user.name}
          </h2>

          <div className="w-full space-y-4 text-left mt-6">
            <div className="flex items-center gap-3 text-gray-600 text-sm">
              <Mail className="w-4 h-4" />
              {selectedPassengerHistory.user.email}
            </div>
            <div className="flex items-center gap-3 text-gray-600 text-sm">
              <Phone className="w-4 h-4" />
              {selectedPassengerHistory.user.phone}
            </div>
            <div className="flex items-center gap-3 text-gray-600 text-sm">
              <MapPin className="w-4 h-4" />
              Colombo, Sri Lanka
            </div>
          </div>

          <div className="mt-auto w-full pt-6 border-t border-gray-200">
            <button
              onClick={handleModalStatusToggle}
              className={`w-full mt-4 py-2 border rounded-lg text-sm font-bold flex items-center justify-center gap-2 ${
                selectedPassengerHistory.user.account_status === 'Active'
                  ? 'border-red-100 text-red-600 hover:bg-red-50'
                  : 'border-green-100 text-green-600 hover:bg-green-50'
              }`}
            >
              <Ban className="w-4 h-4" />
              {selectedPassengerHistory.user.account_status === 'Active'
                ? 'Suspend Account'
                : 'Activate Account'}
            </button>
          </div>
        </div>

        {/* RIGHT SIDE */}
        <div className="w-[70%] p-8 overflow-y-auto">
          <div className="flex justify-between items-center mb-6">
            <h2 className="text-2xl font-black text-gray-900">
              Passenger History
            </h2>

            <div className="flex gap-2">
              <button
                onClick={exportFullPassengerReport}
                className="px-4 py-2 border rounded-lg text-sm font-bold"
              >
                <Download className="w-4 h-4 inline mr-1" />
                Export Report
              </button>
            </div>
          </div>

          <div className="flex gap-6 border-b mb-6">
            {['bookings', 'tickets', 'refunds'].map(tab => (
              <button
                key={tab}
                onClick={() => setHistoryTab(tab)}
                className={`pb-2 border-b-2 font-bold text-sm ${
                  historyTab === tab
                    ? 'border-blue-600 text-blue-600'
                    : 'border-transparent text-gray-400'
                }`}
              >
                {tab.toUpperCase()}
              </button>
            ))}
          </div>

          {/* CONTENT */}
          {historyTab === 'bookings' &&
            selectedPassengerHistory.history.map(b => (
              <div key={b.booking_id} className="border p-4 rounded-xl mb-3">
                {b.start_location} → {b.end_location}
              </div>
            ))}

          {historyTab === 'tickets' &&
            (!selectedPassengerHistory.tickets ||
              selectedPassengerHistory.tickets.length === 0) && (
              <div className="text-center text-gray-400">
                <MessageSquare className="w-10 h-10 mx-auto mb-2" />
                No tickets
              </div>
            )}

          {historyTab === 'refunds' &&
            (!selectedPassengerHistory.refunds ||
              selectedPassengerHistory.refunds.length === 0) && (
              <div className="text-center text-gray-400">
                <RefreshCcw className="w-10 h-10 mx-auto mb-2" />
                No refunds
              </div>
            )}
        </div>
      </div>
    </div>
  );
};

export default PassengerHistoryModal;
